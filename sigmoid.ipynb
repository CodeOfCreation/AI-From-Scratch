   "source": [
    "import numpy as np\n",
    "\n",
    "def sigmoid(z):\n",
    "    return 1 / (1 + np.exp(-z))\n",
    "\n",
    "def sigmoid_derivative(z):\n",
    "    p = sigmoid(z)\n",
    "    return p * (1 - p)\n",
    "\n",
    "z = 2\n",
    "print(sigmoid(z))             # 0.8808 approximately\n",
    "print(sigmoid_derivative(z))  # 0.1050 approximately"
   ]
  }
 ],
